# Public origin of the deployed site, e.g. https://www.example.com
# Used for canonical URLs, sitemap, Open Graph and structured data. Leave unset until the domain is known.
NEXT_PUBLIC_SITE_URL=

# Where enquiry form submissions are forwarded (server-side only).
# Any endpoint that accepts a JSON POST works: Formspree, Make/Zapier webhook, a CRM, or your own API.
# While unset, the form validates input but tells the visitor their enquiry was NOT sent.
ENQUIRY_WEBHOOK_URL=

# Optional bearer token sent as `Authorization: Bearer <token>` to the webhook above.
ENQUIRY_WEBHOOK_TOKEN=

# Live Google reviews on /reviews (Places API "New"). Server-side only.
# Create a key in Google Cloud (enable "Places API (New)", restrict the key to that API).
# Place ID: find it with Google's Place ID Finder, https://developers.google.com/maps/documentation/places/web-service/place-id
# Each page view makes one Place Details request (reviews are not cached, per the Places API terms).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional language for review text (Google translates when needed), e.g. en, it, ar
GOOGLE_PLACES_LANGUAGE=en
